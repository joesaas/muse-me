# MuseMe server（控制面）配置示例。复制为 .env 或直接以环境变量传入。
# 监听地址/端口（默认仅本机回环）
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# 登录口令：默认 demo 仅限本地回环；host 非回环且口令仍为 demo 时拒绝启动
SERVER_PASSWORD=demo
# SQLite 文件路径（相对启动 cwd；默认 data/server.db，即 server/data/server.db）
SERVER_DB=data/server.db
# 运行时模式：local（进程内确定性模拟运行时）| agentcore（AWS Bedrock AgentCore）
SERVER_RUNTIME=local
# 单用户 Demo 的用户 id
SERVER_USER_ID=demo-user
# AgentCore 配置（SERVER_RUNTIME=agentcore 或用 /api/agent/* 管理接口时需要）
AWS_REGION=
AGENTCORE_RUNTIME_ARN=
# OKX 交易所连接（插件市场 OKX 插件与 okx.* 工具用；密钥只走环境变量，永不进仓库）
# 注意：模拟盘必须用在 OKX「交易 > 模拟交易 > 个人中心 > 模拟交易 API」内创建的
# 独立模拟盘 Key（Key/Secret/Passphrase 三件套），不可拿实盘 Key + 开关混用。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_DEMO=1（默认）：所有请求带 x-simulated-trading: 1，走模拟盘虚拟资金
OKX_DEMO=1
# OKX_ALLOW_LIVE=0（默认）：OKX_DEMO=0 时仍须显式 =1 才放行实盘下单，否则拒绝
OKX_ALLOW_LIVE=0
